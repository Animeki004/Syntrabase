{
  "name": "@syntrabase/admin-sdk",
  "version": "1.2.2",
  "type": "module",
  "description": "Privileged server-side Admin SDK for trusted Syntrabase backend integrations",
  "main": "dist/admin-sdk/src/index.js",
  "types": "dist/admin-sdk/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/admin-sdk/src/index.d.ts",
      "default": "./dist/admin-sdk/src/index.js"
    },
    "./app": {
      "types": "./dist/admin-sdk/src/app.d.ts",
      "default": "./dist/admin-sdk/src/app.js"
    },
    "./auth": {
      "types": "./dist/admin-sdk/src/auth.d.ts",
      "default": "./dist/admin-sdk/src/auth.js"
    },
    "./firestore": {
      "types": "./dist/admin-sdk/src/firestore.d.ts",
      "default": "./dist/admin-sdk/src/firestore.js"
    },
    "./rules": {
      "types": "./dist/admin-sdk/src/rules.d.ts",
      "default": "./dist/admin-sdk/src/rules.js"
    },
    "./audit": {
      "types": "./dist/admin-sdk/src/audit.d.ts",
      "default": "./dist/admin-sdk/src/audit.js"
    },
    "./storage": {
      "types": "./dist/admin-sdk/src/storage.d.ts",
      "default": "./dist/admin-sdk/src/storage.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test:unit": "node --test dist/admin-sdk/src/test/admin-sdk.test.js",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@syntrabase/shared-types": "^1.2.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "typescript": "^5.6.3"
  }
}
