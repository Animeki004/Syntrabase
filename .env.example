# ==============================================================================
# SELF-HOSTED FIREBASE-COMPATIBLE PLATFORM (ENVIRONMENT CONFIGURATION TEMPLATE)
# ==============================================================================
# Pre-seeded with cryptographically strong high-entropy keys.
# You can use these keys directly or generate new ones using `openssl rand -hex 32`.

NODE_ENV=production
PLATFORM_DOMAIN=yourdomain.com
PORT=4000
HOST=0.0.0.0

# Coolify Traefik Domain Routing
API_DOMAIN=api.yourdomain.com
CONSOLE_DOMAIN=console.yourdomain.com
ADMIN_DOMAIN=admin.yourdomain.com

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (POSTGRESQL 16+)
# In production, PostgreSQL must run in private network without host port exposure.
# ------------------------------------------------------------------------------
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=syntrabase
DATABASE_USER=postgres
DATABASE_PASSWORD=QGNMdn68bNvMLT6xSpuJfQXz-gV7lor6
DATABASE_SSL=false
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# ------------------------------------------------------------------------------
# 2. JWT & TOKEN SIGNING KEYS (Argon2id & HMAC-SHA256)
# ------------------------------------------------------------------------------
JWT_ACTIVE_KID=key_2026_v1
JWT_SECRET=6c587275f4e55846fab8bb2c48a65240380fcc5111456d6d54e6ad9367a8c827
JWT_PREVIOUS_SECRETS=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PASSWORD_PEPPER=bc5a053976f8c54e106d412d95b609291fdd77eda85b2af46ca18ddfc76f7220

# AES-256-GCM encryption key for email provider credentials (32 hex characters)
CREDENTIALS_ENCRYPTION_KEY=81078bb6114c15689b37baedc87b9caf

# ------------------------------------------------------------------------------
# 3. AUDIT & CRYPTOGRAPHIC LEDGER
# ------------------------------------------------------------------------------
AUDIT_HMAC_SECRET=3e8f104237e8c18df18647a4acdf2472d00d2f003e1e4a925cb235259c5fb65c
AUDIT_LOG_FILE_PATH=/var/log/audit/tamper_evident.log

# ------------------------------------------------------------------------------
# 4. INITIAL PLATFORM SUPER ADMIN BOOTSTRAP
# Used on first launch to seed the primary platform administrator.
# ------------------------------------------------------------------------------
PLATFORM_ADMIN_EMAIL=admin@yourdomain.com
PLATFORM_ADMIN_PASSWORD=xuXqraG6kYILJTnhJ1WzQ3ao!A9

# ------------------------------------------------------------------------------
# 5. STORAGE SUBSYSTEM
# ------------------------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage_data
STORAGE_MAX_FILE_SIZE_BYTES=10485760 # 10 MB

# ------------------------------------------------------------------------------
# 6. RATE LIMITING & SECURITY THRESHOLDS
# ------------------------------------------------------------------------------
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_AUTH_WINDOW_MS=60000
