# ==============================================================================
# SELF-HOSTED FIREBASE-COMPATIBLE PLATFORM (ENVIRONMENT CONFIGURATION TEMPLATE)
# ==============================================================================
# Copy this file to .env and configure your production values.
# In production, generate strong keys using `openssl rand -hex 32` or `openssl rand -base64 48`.

NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 1. DOMAIN ROUTING & PUBLIC URLS (Traefik / Coolify / Caddy)
# ------------------------------------------------------------------------------
PLATFORM_DOMAIN=yourdomain.com

# Ingress subdomains
API_DOMAIN=api.yourdomain.com
CONSOLE_DOMAIN=console.yourdomain.com
ADMIN_DOMAIN=admin.yourdomain.com

# Canonical full URLs used for email action links (password resets, verifications)
CONSOLE_URL=https://console.yourdomain.com
ADMIN_URL=https://admin.yourdomain.com

# Frontend public API gateway target (used by Next.js clients)
NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (POSTGRESQL 16+)
# In production, PostgreSQL must run in private network without host port exposure.
# ------------------------------------------------------------------------------
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=syntrabase
DATABASE_USER=postgres
DATABASE_PASSWORD=your_secure_postgres_password_here
DATABASE_SSL=false
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# ------------------------------------------------------------------------------
# 3. JWT & CRYPTOGRAPHIC TOKEN SIGNING KEYS
# Generate using: `openssl rand -base64 48`
# ------------------------------------------------------------------------------
JWT_ACTIVE_KID=key_2026_v1
JWT_SECRET=your_jwt_secret_key_minimum_64_characters_long_here
JWT_PREVIOUS_SECRETS=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Password hashing pepper (minimum 16 characters). Generate: `openssl rand -base64 32`
PASSWORD_PEPPER=your_password_pepper_32_characters_long_here

# AES-256-GCM encryption key for email credentials and TOTP secrets (32 bytes / 64 hex characters)
# Generate: `openssl rand -hex 32`
CREDENTIALS_ENCRYPTION_KEY=your_credentials_encryption_key_32b_here

# ------------------------------------------------------------------------------
# 4. AUDIT & CRYPTOGRAPHIC LEDGER
# HMAC-SHA256 key for tamper-evident audit chain. Generate: `openssl rand -hex 32`
# ------------------------------------------------------------------------------
AUDIT_HMAC_SECRET=your_audit_hmac_secret_sha256_key_here
AUDIT_LOG_FILE_PATH=/var/log/audit/tamper_evident.log

# ------------------------------------------------------------------------------
# 5. WEBAUTHN / FIDO2 PASSKEYS CONFIGURATION
# ------------------------------------------------------------------------------
WEBAUTHN_RP_NAME=Syntrabase Cloud
# RP_ID must match the top-level effective domain of your console/admin (e.g. yourdomain.com, or localhost for local dev)
WEBAUTHN_RP_ID=yourdomain.com
# Comma-separated allowed browser origins for passkey authentication
WEBAUTHN_ORIGINS=https://console.yourdomain.com,https://admin.yourdomain.com,http://localhost:3000,http://localhost:3001

# ------------------------------------------------------------------------------
# 6. SYSTEM EMAIL & NOTIFICATION BRANDING
# Default fallback identities for system password resets and security alerts.
# ------------------------------------------------------------------------------
SYSTEM_FROM_EMAIL=security@yourdomain.com
SYSTEM_FROM_NAME=Syntrabase Security

# ------------------------------------------------------------------------------
# 7. INITIAL PLATFORM SUPER ADMIN BOOTSTRAP
# Used on first launch to seed the primary platform administrator in the database.
# ------------------------------------------------------------------------------
PLATFORM_ADMIN_EMAIL=admin@yourdomain.com
PLATFORM_ADMIN_PASSWORD=your_super_admin_secure_password_here

# ------------------------------------------------------------------------------
# 8. STORAGE SUBSYSTEM
# ------------------------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage_data
STORAGE_MAX_FILE_SIZE_BYTES=10485760 # 10 MB

# ------------------------------------------------------------------------------
# 9. RATE LIMITING & SECURITY THRESHOLDS
# ------------------------------------------------------------------------------
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_AUTH_WINDOW_MS=60000
